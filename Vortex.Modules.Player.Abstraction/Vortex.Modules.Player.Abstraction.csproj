<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Deliberately does not import ProjectConfiguration.Base: that pulls in
      Vortex.Framework.Abstraction, which references this project in turn.
      Nothing here needs it, only the shared models.
    -->

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vortex.Shared\Vortex.Shared.csproj" />
    </ItemGroup>

</Project>
