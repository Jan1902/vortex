namespace Vortex.Data;

/// <summary>
/// How hard blocks are to break. Mojang's data does not say; the values are
/// taken from PrismarineJS.
/// </summary>
public static class BlockStrength
{
    /// <summary>
    /// How hard the block is to break: 0 breaks at once, -1 cannot be broken.
    /// </summary>
    public static float Hardness(this Block block) => block switch
    {
        {{hardness}}
        _ => {{defaultHardness}}
    };

    /// <summary>
    /// Whether the block only drops anything when mined with the right tool,
    /// as stone needs a pickaxe.
    /// </summary>
    public static bool RequiresCorrectToolForDrops(this Block block) => block is
        {{requiresTool}};
}

