namespace Vortex.Data;

/// <summary>
/// The name of a field in an entity's metadata, such as its health or the item
/// it is. Which index a field has depends on the entity type; see
/// <see cref="EntityDataKeys"/>.
/// </summary>
public enum EntityDataKey
{
    {{keys}}
}

/// <summary>
/// What each metadata index means for each entity type. Mojang's data does not
/// say; the names are taken from PrismarineJS.
/// </summary>
public static class EntityDataKeys
{
    private static readonly EntityDataKey[][] _byType =
    [
        {{types}}
    ];

    /// <summary>The fields of an entity type's metadata, by index.</summary>
    public static IReadOnlyList<EntityDataKey> Of(EntityType type)
        => _byType[(int)type];

    /// <summary>
    /// The index a field has in an entity type's metadata.
    /// </summary>
    /// <returns>The index, or -1 if entities of this type do not have the field.</returns>
    public static int IndexOf(EntityType type, EntityDataKey key)
        => System.Array.IndexOf(_byType[(int)type], key);
}

