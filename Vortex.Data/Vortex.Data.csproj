<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The game's static data - registries, blocks, items, tags, recipes and loot
    tables - as C# types. Everything under Resources comes from Mojang's data
    generator (scripts/update-protocol-data.sh) and is turned into code at build
    time, so none of it is parsed at runtime and a name that does not exist is a
    compile error rather than a lookup that fails.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="Resources\**\*.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vortex.Data.CodeGeneration\Vortex.Data.CodeGeneration.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
