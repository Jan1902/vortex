<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Deliberately does not import ProjectConfiguration.Base: that pulls in
      Vortex.Framework.Abstraction, which references this project in turn so
      that IVortexClient can hand out the brain. The module abstractions are
      fine: they reference nothing of the framework.
    -->

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vortex.Shared\Vortex.Shared.csproj" />
        <ProjectReference Include="..\Vortex.Modules.Crafting.Abstraction\Vortex.Modules.Crafting.Abstraction.csproj" />
        <ProjectReference Include="..\Vortex.Modules.Entities.Abstraction\Vortex.Modules.Entities.Abstraction.csproj" />
        <ProjectReference Include="..\Vortex.Modules.Interaction.Abstraction\Vortex.Modules.Interaction.Abstraction.csproj" />
        <ProjectReference Include="..\Vortex.Modules.Inventory.Abstraction\Vortex.Modules.Inventory.Abstraction.csproj" />
        <ProjectReference Include="..\Vortex.Modules.Navigation.Abstraction\Vortex.Modules.Navigation.Abstraction.csproj" />
        <ProjectReference Include="..\Vortex.Modules.Player.Abstraction\Vortex.Modules.Player.Abstraction.csproj" />
        <ProjectReference Include="..\Vortex.Modules.World.Abstraction\Vortex.Modules.World.Abstraction.csproj" />
    </ItemGroup>

</Project>
